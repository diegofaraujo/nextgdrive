    <file alias="icons/32x32/apps/io.github.diegofaraujo.NextGDrive.png">icons/hicolor/32x32/apps/io.github.diegofaraujo.NextGDrive.png</file>
    <file alias="icons/48x48/apps/io.github.diegofaraujo.NextGDrive.png">icons/hicolor/48x48/apps/io.github.diegofaraujo.NextGDrive.png</file>
    <file alias="icons/64x64/apps/io.github.diegofaraujo.NextGDrive.png">icons/hicolor/64x64/apps/io.github.diegofaraujo.NextGDrive.png</file>
    <file alias="icons/128x128/apps/io.github.diegofaraujo.NextGDrive.png">icons/hicolor/128x128/apps/io.github.diegofaraujo.NextGDrive.png</file>
    <file alias="icons/256x256/apps/io.github.diegofaraujo.NextGDrive.png">icons/hicolor/256x256/apps/io.github.diegofaraujo.NextGDrive.png</file>
